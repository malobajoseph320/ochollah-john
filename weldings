    <!-- JAVASCRIPT FOR INTERACTIVITY & CALCULATOR -->
    <script>
        // Mobile Menu Toggle
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        menuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Portfolio Filter Functionality
        const filterBtns = document.querySelectorAll('.filter-btn');
        const galleryItems = document.querySelectorAll('.gallery-item');

        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                // Remove active styling
                filterBtns.forEach(b => {
                    b.classList.remove('bg-spark-500', 'text-white', 'active');
                    b.classList.add('bg-steel-700', 'text-slate-200');
                });
                
                // Add active to clicked
                btn.classList.add('bg-spark-500', 'text-white', 'active');
                btn.classList.remove('bg-steel-700', 'text-slate-200');

                const filter = btn.getAttribute('data-filter');

                galleryItems.forEach(item => {
                    if (filter === 'all' || item.classList.contains(filter)) {
                        item.style.display = 'block';
                    } else {
                        item.style.display = 'none';
                    }
                });
            });
        });

        // Calculator Logic
        const calcItem = document.getElementById('calc-item');
        const calcHeight = document.getElementById('calc-height');
        const calcWidth = document.getElementById('calc-width');
        const optPrimer = document.getElementById('opt-primer');
        const optFitting = document.getElementById('opt-fitting');
        const estimatedTotal = document.getElementById('estimated-total');
        const whatsappBookingBtn = document.getElementById('send-whatsapp-booking-btn');

        function calculateCost() {
            const selectedOption = calcItem.options[calcItem.selectedIndex];
            const ratePerSqFt = parseFloat(selectedOption.getAttribute('data-rate')) || 1500;
            const h = parseFloat(calcHeight.value) || 0;
            const w = parseFloat(calcWidth.value) || 0;

            const area = h * w;
            let total = area * ratePerSqFt;

            if (optPrimer.checked) total += 1500;
            if (optFitting.checked) total += 2500;

            // Minimum job base cost safeguard
            if (total < 5000 && area > 0) total = 5000;

            estimatedTotal.textContent = `KSh ${total.toLocaleString()}`;
            return total;
        }

        // Add event listeners for dynamic instant calculation
        [calcItem, calcHeight, calcWidth, optPrimer, optFitting].forEach(elem => {
            elem.addEventListener('input', calculateCost);
            elem.addEventListener('change', calculateCost);
        });

        // WhatsApp Order Dispatch
        whatsappBookingBtn.addEventListener('click', () => {
            const itemText = calcItem.options[calcItem.selectedIndex].text;
            const h = calcHeight.value;
            const w = calcWidth.value;
            const notes = document.getElementById('calc-notes').value || 'None specified';
            const cost = calculateCost();

            const primerText = optPrimer.checked ? 'Yes' : 'No';
            const fittingText = optFitting.checked ? 'Yes' : 'No';

            const message = `Hello John Ocholah, I would like to book a welding job from your website:%0A%0A` +
                            `• *Item:* ${encodeURIComponent(itemText)}%0A` +
                            `• *Dimensions:* ${h} ft (H) x ${w} ft (W)%0A` +
                            `• *Anti-Rust Primer:* ${primerText}%0A` +
                            `• *On-Site Fitting:* ${fittingText}%0A` +
                            `• *Location/Notes:* ${encodeURIComponent(notes)}%0A` +
                            `• *Estimated Cost:* KSh ${cost.toLocaleString()}%0A%0A` +
                            `Please confirm availability & site measurement date.`;

            window.open(`https://wa.me/254114369336?text=${message}`, '_blank');
        });

        // Quick Gallery Order trigger
        function orderItem(itemName) {
            const message = `Hello John Ocholah, I am interested in ordering: *${encodeURIComponent(itemName)}* seen on your metalwork website. Please share full details and pricing for Eldoret town delivery.`;
            window.open(`https://wa.me/254114369336?text=${message}`, '_blank');
